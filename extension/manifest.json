{
  "manifest_version": 2,
  "name": "MCP Bridge for Firefox",
  "version": "1.13.0",
  "description": "Let Claude, Cursor or any MCP client use your Firefox: read pages, click, type, upload files and take screenshots, with no automation mode.",
  "author": "Dor Zairi (based on FoxMCP by ThinkerYzu)",
  "homepage_url": "https://github.com/MashdorDev/mcp-bridge-for-firefox",
  "license": "MIT",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "history",
    "bookmarks",
    "activeTab",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "settings.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "settings.js",
        "content.js"
      ]
    }
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "MCP Bridge for Firefox",
    "default_icon": "icons/toolbar.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxmcp@dorzairi.dev",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity",
          "websiteActivity",
          "bookmarksInfo",
          "authenticationInfo"
        ]
      }
    }
  }
}
